    {
      "id": "016e32b1-5ac4-4464-909d-f90413ac22d6",
      "name": "Resolver etiquetas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "// Une las etiquetas de Gmail con lo que mailcat pide aplicar.\nconst labels = $('Etiquetas de Gmail').first().json.labels || [];\nconst idByName = Object.fromEntries(labels.map(l => [l.name, l.id]));\nconst items = ($input.first().json.items) || [];\nconst out = [];\nconst missing = new Set();\nfor (const it of items) {\n  const add = idByName[it.label];\n  if (!add) { missing.add(it.label); continue; }\n  const prev = it.previous_label ? idByName[it.previous_label] : undefined;\n  out.push({ json: {\n    email_id: it.email_id,\n    category: it.category,\n    messageId: it.email_id.replace(/^gmail-/, ''),\n    modify: { addLabelIds: [add], removeLabelIds: prev && prev !== add ? [prev] : [] },\n  } });\n}\nif (missing.size) console.log('Faltan estas etiquetas en Gmail (ejecuta el workflow \"3 Crear etiquetas\"):', [...missing]);\nreturn out;"
      }
    },
    {
      "id": "4db21bb1-a3ef-4b82-bc50-bfeaab0d356c",
      "name": "Aplicar etiqueta en Gmail",
      "type": "n8n-nodes-base.httpRequest",
